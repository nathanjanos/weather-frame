# Install: see INSTALL.md §3.
#
# NOTE: Raspberry Pi OS's desktop session (labwc, and Wayfire before it)
# never activates systemd's user graphical-session.target, so this unit
# must NOT rely on WantedBy=graphical-session.target — it would simply
# never start at boot. Instead the desktop's autostart file
# (~/.config/labwc/autostart) imports the display environment and starts
# the service once the compositor is actually up; systemd then
# supervises it (Restart=always).
#
# Assumes the project lives at /home/pi/weather-frame — edit paths if not.

[Unit]
Description=Weather Frame slideshow

[Service]
Type=simple
WorkingDirectory=/home/pi/weather-frame
ExecStart=/usr/bin/python3 /home/pi/weather-frame/weather_frame.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
